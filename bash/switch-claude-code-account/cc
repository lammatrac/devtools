#!/usr/bin/env bash

set -euo pipefail

CLAUDE_DIR="$HOME/.claude"
CREDENTIALS="$CLAUDE_DIR/.credentials.json"
GLOBAL_CONFIG="$HOME/.claude.json"

ACCOUNT_DIR="$HOME/.claude-accounts"
STATE_FILE="$ACCOUNT_DIR/current"

die() {
    echo "✗ $*" >&2
    exit 1
}

info() {
    echo "✓ $*"
}

usage() {
    cat <<'HELP'

Claude Code Account Switcher

Usage:
  cc lammatrac       Switch to lammatrac
  cc wlx             Switch to wlx
  cc current         Show current account
  cc list            List accounts
  cc save <account>  Save current account
  cc status          Show status
  cc help            Show this help

HELP
}

validate_account() {
    case "$1" in
        lammatrac|wlx) ;;
        *) die "Unknown account: $1 (use lammatrac or wlx)" ;;
    esac
}

account_credentials() {
    echo "$ACCOUNT_DIR/$1.credentials.json"
}

account_oauth() {
    echo "$ACCOUNT_DIR/$1.oauthAccount.json"
}

get_oauth_account() {
    [[ -f "$GLOBAL_CONFIG" ]] || return 1

    python3 - "$GLOBAL_CONFIG" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)

    value = data.get("oauthAccount")

    if value is None:
        sys.exit(1)

    print(json.dumps(value, ensure_ascii=False, indent=2))
except Exception:
    sys.exit(1)
PY
}

set_oauth_account() {
    local oauth_file="$1"

    [[ -f "$oauth_file" ]] || return 0

    python3 - "$GLOBAL_CONFIG" "$oauth_file" <<'PY'
import json
import os
import sys
import tempfile

config_path = sys.argv[1]
oauth_path = sys.argv[2]

with open(oauth_path, "r", encoding="utf-8") as f:
    oauth = json.load(f)

if os.path.exists(config_path):
    with open(config_path, "r", encoding="utf-8") as f:
        data = json.load(f)
else:
    data = {}

data["oauthAccount"] = oauth

directory = os.path.dirname(config_path) or "."
fd, tmp = tempfile.mkstemp(prefix=".claude-config-", dir=directory)

try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")

    os.chmod(tmp, 0o600)
    os.replace(tmp, config_path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
}

save_current() {
    local account="$1"

    validate_account "$account"

    mkdir -p "$ACCOUNT_DIR"
    chmod 700 "$ACCOUNT_DIR"

    [[ -f "$CREDENTIALS" ]] || \
        die "Claude credentials not found: $CREDENTIALS"

    cp "$CREDENTIALS" "$(account_credentials "$account")"
    chmod 600 "$(account_credentials "$account")"

    if oauth="$(get_oauth_account 2>/dev/null)"; then
        printf '%s\n' "$oauth" > "$(account_oauth "$account")"
        chmod 600 "$(account_oauth "$account")"
    fi

    printf '%s\n' "$account" > "$STATE_FILE"
    chmod 600 "$STATE_FILE"

    info "Saved current account as: $account"
}

switch_account() {
    local account="$1"

    validate_account "$account"

    mkdir -p "$ACCOUNT_DIR"
    chmod 700 "$ACCOUNT_DIR"

    local target_credentials
    local target_oauth

    target_credentials="$(account_credentials "$account")"
    target_oauth="$(account_oauth "$account")"

    [[ -f "$target_credentials" ]] || {
        echo
        echo "Account '$account' has not been saved yet."
        echo
        echo "Login to that account with Claude Code first, then run:"
        echo
        echo "  cc save $account"
        echo
        exit 1
    }

    local current=""

    if [[ -f "$STATE_FILE" ]]; then
        current="$(cat "$STATE_FILE")"
    fi

    if [[ "$current" == "$account" ]]; then
        info "Already using account: $account"
        return
    fi

    # Save the currently active credentials before switching.
    if [[ -f "$CREDENTIALS" && -n "$current" ]]; then
        local current_credentials
        local current_oauth

        current_credentials="$(account_credentials "$current")"
        current_oauth="$(account_oauth "$current")"

        cp "$CREDENTIALS" "$current_credentials"
        chmod 600 "$current_credentials"

        if oauth="$(get_oauth_account 2>/dev/null)"; then
            printf '%s\n' "$oauth" > "$current_oauth"
            chmod 600 "$current_oauth"
        fi
    fi

    # Install target credentials.
    cp "$target_credentials" "$CREDENTIALS"
    chmod 600 "$CREDENTIALS"

    # Restore target oauthAccount.
    if [[ -f "$target_oauth" ]]; then
        set_oauth_account "$target_oauth"
    fi

    printf '%s\n' "$account" > "$STATE_FILE"
    chmod 600 "$STATE_FILE"

    info "Switched Claude account → $account"
}

current_account() {
    if [[ -f "$STATE_FILE" ]]; then
        echo "Claude account: $(cat "$STATE_FILE")"
    elif [[ -f "$CREDENTIALS" ]]; then
        echo "Claude account: unknown"
        echo
        echo "Save it with:"
        echo "  cc save lammatrac"
        echo "or:"
        echo "  cc save wlx"
    else
        echo "Claude account: not configured"
    fi
}

list_accounts() {
    echo
    echo "Claude accounts:"
    echo

    for account in lammatrac wlx; do
        if [[ -f "$(account_credentials "$account")" ]]; then
            if [[ -f "$STATE_FILE" ]] && \
               [[ "$(cat "$STATE_FILE")" == "$account" ]]; then
                echo "  ● $account (active)"
            else
                echo "  ○ $account"
            fi
        else
            echo "  - $account (not configured)"
        fi
    done

    echo
}

status() {
    echo "Claude Code:"
    claude --version 2>/dev/null || echo "  claude command not found"

    echo
    current_account

    echo
    echo "Shared config:"
    echo "  $CLAUDE_DIR"

    echo
    echo "Account credentials:"
    echo "  $ACCOUNT_DIR"
}

case "${1:-help}" in
    lammatrac)
        switch_account lammatrac
        ;;

    wlx)
        switch_account wlx
        ;;

    current)
        current_account
        ;;

    list)
        list_accounts
        ;;

    status)
        status
        ;;

    save)
        [[ $# -eq 2 ]] || die "Usage: cc save <lammatrac|wlx>"
        save_current "$2"
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        die "Unknown command: $1 (try: cc help)"
        ;;
esac